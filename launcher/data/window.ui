<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwApplicationWindow" id="win">
    <property name="title" translatable="no">MCPE Launcher</property>
    <property name="default-width">920</property>
    <property name="default-height">640</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-title">True</property>
            <child type="end">
              <object class="GtkButton" id="add_btn">
                <property name="label" translatable="no">Add APK</property>
                <property name="icon-name">document-open-symbolic</property>
                <property name="tooltip-text" translatable="no">Install a Minecraft APK</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="no">Menu</property>
                <property name="menu-model">primary_menu</property>
                <property name="direction">down</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="GtkStack" id="main_stack">
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="empty_page">
                        <property name="title" translatable="no">No versions installed</property>
                        <property name="description" translatable="no">Add a Minecraft APK to install a version. Only APKs with x86_64 native binaries are supported.</property>
                        <property name="icon-name">application-x-executable-symbolic</property>
                        <child>
                          <object class="GtkButton" id="empty_add_btn">
                            <property name="label" translatable="no">Add APK</property>
                            <property name="icon-name">document-open-symbolic</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">list</property>
                    <property name="child">
                      <object class="GtkScrolledWindow" id="list_page">
                        <property name="hscrollbar-policy">never</property>
                        <child>
                          <object class="GtkListBox" id="version_list">
                            <property name="selection-mode">none</property>
                            <property name="css-classes">boxed-list</property>
                            <property name="vexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <menu id="primary_menu">
    <item>
      <attribute name="label" translatable="no">Settings…</attribute>
      <attribute name="action">app.settings</attribute>
    </item>
    <item>
      <attribute name="label" translatable="no">About</attribute>
      <attribute name="action">app.about</attribute>
    </item>
  </menu>
</interface>